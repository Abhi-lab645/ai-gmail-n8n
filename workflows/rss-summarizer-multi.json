{
  "name": "RSS Summarizer (Multi-Source)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        380,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { source: \"BBC Tech\", url: \"https://feeds.bbci.co.uk/news/technology/rss.xml\" } },\n  { json: { source: \"TechCrunch\", url: \"https://techcrunch.com/feed/\" } },\n  { json: { source: \"The Verge\", url: \"https://www.theverge.com/rss/index.xml\" } },\n  { json: { source: \"Wired\", url: \"https://www.wired.com/feed/rss\" } }\n];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Feed Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        240
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "RSS Read",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        780,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst countBySource = {};\nconst maxPerSource = 2;\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const link = data.link || \"\";\n  \n  let source = \"Tech News\";\n  if (link.includes(\"bbc.co.uk\") || link.includes(\"bbc.com\")) {\n    source = \"BBC Tech\";\n  } else if (link.includes(\"techcrunch.com\")) {\n    source = \"TechCrunch\";\n  } else if (link.includes(\"theverge.com\")) {\n    source = \"The Verge\";\n  } else if (link.includes(\"wired.com\")) {\n    source = \"Wired\";\n  }\n\n  countBySource[source] = (countBySource[source] || 0) + 1;\n  if (countBySource[source] <= maxPerSource) {\n    let snippet = (data.contentSnippet || data.content || data.title || \"\").trim();\n    snippet = snippet.replace(/<[^>]*>?/gm, \"\");\n    if (snippet.length > 500) {\n      snippet = snippet.slice(0, 500) + \"...\";\n    }\n\n    output.push({\n      json: {\n        source: source,\n        title: (data.title || \"Untitled\").trim(),\n        link: link,\n        pubDate: data.pubDate || data.isoDate || new Date().toUTCString(),\n        contentSnippet: snippet\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Format and Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarize this article in 2 plain-English sentences. Highlight the main news impact.\n\nSource: {{ $json.source }}\nTitle: {{ $json.title }}\n\nContent: {{ $json.contentSnippet }}"
      },
